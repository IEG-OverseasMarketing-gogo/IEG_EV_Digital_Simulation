<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>IEG Simulator Trial Request</title>
<style>
  :root{
    --paper:#EEF2F4; --card:#FFFFFF; --ink:#14232E; --muted:#5B6B77; --line:#CBD5DB;
    --teal:#0E7C86; --teal-dark:#0A5C64; --teal-tint:#E1F1F2; --amber:#F2B632; --err:#B3261E;
  }
  @media (prefers-color-scheme: dark){
    :root{ --paper:#0F1A22; --card:#16252F; --ink:#E8EEF2; --muted:#9BAAB5; --line:#2C3E4B;
      --teal:#38B2BC; --teal-dark:#7FD3DA; --teal-tint:#153840; --err:#FF8A80; }
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--paper);color:var(--ink);
    font-family:"Segoe UI","Apple SD Gothic Neo","Malgun Gothic",system-ui,-apple-system,sans-serif;
    line-height:1.55;-webkit-font-smoothing:antialiased}
  .wrap{max-width:760px;margin:0 auto;padding:28px 18px 64px}
  .topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
  .brand{font-weight:800;letter-spacing:.02em;font-size:18px}
  .brand span{color:var(--teal)}
  .lang{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--card)}
  .lang button{border:0;background:transparent;color:var(--muted);padding:6px 12px;font:inherit;font-size:13px;cursor:pointer}
  .lang button[aria-pressed="true"]{background:var(--ink);color:var(--paper);font-weight:600}
  h1{font-size:clamp(28px,5vw,40px);line-height:1.15;letter-spacing:-.02em;margin:0 0 10px;font-weight:800}
  .lead{color:var(--muted);margin:0 0 30px;max-width:56ch}
  fieldset{border:0;margin:0 0 30px;padding:0}
  legend{font-size:19px;font-weight:700;padding:0;margin-bottom:4px}
  .hint{color:var(--muted);font-size:14px;margin:0 0 14px}

  /* simulator tiles — the one expressive element */
  .sims{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  .sim{position:relative;display:flex;align-items:center;gap:14px;background:var(--card);
    border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;cursor:pointer;min-height:76px;
    transition:border-color .15s, background .15s}
  .sim:hover{border-color:var(--teal)}
  .sim input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer;margin:0}
  .sim .wk{flex:none;width:52px;text-align:center;border-right:1.5px solid var(--line);padding-right:12px}
  .sim .wk b{display:block;font-size:26px;line-height:1;font-variant-numeric:tabular-nums;color:var(--teal)}
  .sim .wk small{font-size:11px;color:var(--muted)}
  .sim .nm{font-weight:600;font-size:15px;line-height:1.3}
  .sim .nm small{display:block;font-weight:400;color:var(--muted);font-size:12.5px;margin-top:2px}
  .sim .tick{position:absolute;top:8px;right:8px;width:18px;height:18px;border-radius:50%;
    border:1.5px solid var(--line);display:grid;place-items:center;font-size:11px;color:transparent}
  .sim:has(input:checked){border-color:var(--teal);background:var(--teal-tint)}
  .sim:has(input:checked) .tick{background:var(--amber);border-color:var(--amber);color:#14232E;font-weight:800}
  .sim:has(input:focus-visible){outline:3px solid var(--teal);outline-offset:2px}
  .counter{font-size:13px;color:var(--muted);margin-top:10px}

  .grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .field{display:flex;flex-direction:column;gap:5px}
  .field.full{grid-column:1/-1}
  label.l{font-size:14px;font-weight:600}
  label.l i{color:var(--err);font-style:normal;margin-left:2px}
  input[type=text],input[type=email],input[type=tel],select,textarea{
    width:100%;font:inherit;font-size:15px;color:var(--ink);background:var(--card);
    border:1.5px solid var(--line);border-radius:8px;padding:10px 12px}
  textarea{min-height:96px;resize:vertical}
  input:focus,select:focus,textarea:focus{outline:3px solid var(--teal-tint);border-color:var(--teal)}
  .err{color:var(--err);font-size:13px;min-height:0}
  .invalid{border-color:var(--err)!important}
  .consent{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--muted);margin:6px 0 22px}
  .consent input{margin-top:4px;width:18px;height:18px;accent-color:var(--teal);flex:none}
  .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .submit{width:100%;border:0;border-radius:10px;background:var(--teal);color:#fff;font:inherit;
    font-size:17px;font-weight:700;padding:15px;cursor:pointer}
  .submit:hover{background:var(--teal-dark)}
  .submit:disabled{opacity:.6;cursor:wait}
  .status{margin-top:12px;font-size:14px;color:var(--err)}
  .done{display:none;background:var(--card);border:1.5px solid var(--teal);border-radius:12px;padding:32px 24px;text-align:center}
  .done h2{margin:0 0 8px;font-size:26px}
  .done p{color:var(--muted);margin:0}
  .foot{margin-top:30px;font-size:12.5px;color:var(--muted);text-align:center}
  @media (max-width:620px){ .sims,.grid{grid-template-columns:1fr} }
  @media (prefers-reduced-motion:reduce){ *{transition:none!important;scroll-behavior:auto!important} }
</style>
</head>
<body>
<div class="wrap">

  <div class="topbar">
    <div class="brand">IEG <span>Simulator Lab</span></div>
    <div class="lang" role="group" aria-label="Language">
      <button type="button" data-lang="en" aria-pressed="true">EN</button>
      <button type="button" data-lang="ko" aria-pressed="false">한국어</button>
    </div>
  </div>

  <div id="formArea">
    <h1 data-i18n="title">Try an IEG simulator</h1>
    <p class="lead" data-i18n="lead">Choose the simulators you want to experience and tell us a little about yourself. Our team will contact you with trial access.</p>

    <form id="survey" novalidate>
      <!-- honeypot for bots -->
      <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>

      <fieldset id="simFieldset">
        <legend data-i18n="simLegend">Which simulators interest you?</legend>
        <p class="hint" data-i18n="simHint">Select one or more.</p>
        <div class="sims" id="sims"></div>
        <div class="counter" id="simCount"></div>
        <div class="err" id="err-sims" role="alert"></div>
      </fieldset>

      <fieldset>
        <legend data-i18n="aboutLegend">About you</legend>
        <div class="grid">
          <div class="field">
            <label class="l" for="name"><span data-i18n="name">Full name</span><i>*</i></label>
            <input type="text" id="name" name="name" autocomplete="name" required>
            <div class="err" id="err-name"></div>
          </div>
          <div class="field">
            <label class="l" for="email"><span data-i18n="email">Email</span><i>*</i></label>
            <input type="email" id="email" name="email" autocomplete="email" required>
            <div class="err" id="err-email"></div>
          </div>
          <div class="field">
            <label class="l" for="phone"><span data-i18n="phone">Phone / WhatsApp</span></label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+82 10 0000 0000">
          </div>
          <div class="field">
            <label class="l" for="country"><span data-i18n="country">Country / Region</span><i>*</i></label>
            <input type="text" id="country" name="country" list="countryList" autocomplete="country-name" required>
            <datalist id="countryList"></datalist>
            <div class="err" id="err-country"></div>
          </div>
          <div class="field">
            <label class="l" for="city"><span data-i18n="city">City</span></label>
            <input type="text" id="city" name="city" autocomplete="address-level2">
          </div>
          <div class="field">
            <label class="l" for="org"><span data-i18n="org">Organization</span><i>*</i></label>
            <input type="text" id="org" name="organization" autocomplete="organization" required>
            <div class="err" id="err-org"></div>
          </div>
          <div class="field">
            <label class="l" for="ctype"><span data-i18n="ctype">I am a / an</span><i>*</i></label>
            <select id="ctype" name="customerType" required>
              <option value="" data-i18n="select">Select…</option>
              <option value="TVET / Vocational institution" data-i18n="ct1">TVET / vocational institution</option>
              <option value="University / Polytechnic" data-i18n="ct2">University / polytechnic</option>
              <option value="Company / Industry" data-i18n="ct3">Company / industry</option>
              <option value="Government / Public agency / ODA" data-i18n="ct4">Government / public agency / ODA</option>
              <option value="Distributor / Partner" data-i18n="ct5">Distributor / partner</option>
              <option value="Individual instructor / Trainer" data-i18n="ct6">Individual instructor / trainer</option>
              <option value="Student / Learner" data-i18n="ct7">Student / learner</option>
              <option value="Other" data-i18n="ct8">Other</option>
            </select>
            <div class="err" id="err-ctype"></div>
          </div>
          <div class="field">
            <label class="l" for="job"><span data-i18n="job">Job title</span></label>
            <input type="text" id="job" name="jobTitle" autocomplete="organization-title">
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend data-i18n="motLegend">Your goal</legend>
        <div class="grid">
          <div class="field full">
            <label class="l" for="purpose"><span data-i18n="purpose">Main reason for trying the simulator</span><i>*</i></label>
            <select id="purpose" name="purpose" required>
              <option value="" data-i18n="select">Select…</option>
              <option value="Personal learning" data-i18n="p1">Personal learning</option>
              <option value="Training my students / trainees" data-i18n="p2">Training my students / trainees</option>
              <option value="Curriculum adoption" data-i18n="p3">Adopting it into our curriculum</option>
              <option value="Procurement / Tender" data-i18n="p4">Procurement or tender preparation</option>
              <option value="Partnership / Distribution" data-i18n="p5">Partnership or distribution</option>
              <option value="Research / Evaluation" data-i18n="p6">Research or evaluation</option>
              <option value="Other" data-i18n="p7">Other</option>
            </select>
            <div class="err" id="err-purpose"></div>
          </div>
          <div class="field full">
            <label class="l" for="message"><span data-i18n="message">Anything else we should know?</span></label>
            <textarea id="message" name="message" maxlength="1000" data-i18n-ph="messagePh" placeholder="Number of trainees, timeline, questions…"></textarea>
          </div>
        </div>
      </fieldset>

      <label class="consent">
        <input type="checkbox" id="consent" name="consent">
        <span data-i18n="consent">I agree that IEG may use my information to contact me about simulator trials and related services.</span>
      </label>
      <div class="err" id="err-consent" style="margin:-14px 0 14px"></div>

      <button class="submit" type="submit" id="submitBtn" data-i18n="submit">Request trial access</button>
      <div class="status" id="status" role="alert"></div>
    </form>
  </div>

  <div class="done" id="done" role="status">
    <h2 data-i18n="doneTitle">Thank you!</h2>
    <p data-i18n="doneText">We received your request and will contact you by email soon.</p>
  </div>

  <div class="foot">IEG Co., Ltd. · Global Business Division</div>
</div>

<script>
/* ============================================================
   ★ 설정: Apps Script 웹앱 URL을 아래에 붙여넣으세요 (…/exec)
   ============================================================ */
const APPS_SCRIPT_URL = "PASTE_YOUR_WEB_APP_URL_HERE";

/* 시뮬레이터 목록 — id/value는 구글시트에 저장되는 영문명 (Apps Script의 SIMULATORS와 동일해야 함) */
const SIMULATORS = [
  {value:"IEG-6030 Virtual Electrical Lab Simulator", weeks:8,  ko:"IEG-6030 가상 전기 실습 시뮬레이터"},
  {value:"EV Diagnostic & Repair",                    weeks:16, ko:"전기차 진단 및 정비"},
  {value:"ICE Bridge Preliminary",                    weeks:6,  ko:"ICE 브릿지 예비과정"},
  {value:"Electrical, PLC, EV",                       weeks:12, ko:"전기 · PLC · EV 통합과정"},
  {value:"Thermal Management System",                 weeks:10, ko:"열관리 시스템"},
  {value:"Semiconductor 8-Process Digital Twin",      weeks:8,  ko:"반도체 8공정 디지털 트윈"},
  {value:"EV Simulator Lab",                          weeks:8,  ko:"EV 시뮬레이터 랩"},
  {value:"E-Autobike",                                weeks:4,  ko:"전기 오토바이(E-Autobike)"}
];

const COUNTRIES = ["South Korea","Uzbekistan","Indonesia","Kenya","Uganda","Ethiopia","Ghana","Rwanda","Saudi Arabia","UAE","Jordan","Malaysia","Vietnam","Philippines","Singapore","Mongolia","India","Colombia","United States","Georgia (country)","Other"];

const I18N = {
  en:{
    title:"Try an IEG simulator",
    lead:"Choose the simulators you want to experience and tell us a little about yourself. Our team will contact you with trial access.",
    simLegend:"Which simulators interest you?", simHint:"Select one or more.",
    aboutLegend:"About you", name:"Full name", email:"Email", phone:"Phone / WhatsApp",
    country:"Country / Region", city:"City", org:"Organization", ctype:"I am a / an", job:"Job title",
    select:"Select…",
    ct1:"TVET / vocational institution", ct2:"University / polytechnic", ct3:"Company / industry",
    ct4:"Government / public agency / ODA", ct5:"Distributor / partner", ct6:"Individual instructor / trainer",
    ct7:"Student / learner", ct8:"Other",
    motLegend:"Your goal", purpose:"Main reason for trying the simulator",
    p1:"Personal learning", p2:"Training my students / trainees", p3:"Adopting it into our curriculum",
    p4:"Procurement or tender preparation", p5:"Partnership or distribution", p6:"Research or evaluation", p7:"Other",
    message:"Anything else we should know?", messagePh:"Number of trainees, timeline, questions…",
    consent:"I agree that IEG may use my information to contact me about simulator trials and related services.",
    submit:"Request trial access", sending:"Sending…",
    weeks:"weeks", wk:"wk", selected:n=>`${n} selected`,
    eReq:"This field is required.", eEmail:"Enter a valid email address.", eSim:"Select at least one simulator.",
    eConsent:"Please agree to continue.", eNet:"Could not send. Check your connection and try again.",
    eCfg:"Survey is not connected to Google Sheets yet (APPS_SCRIPT_URL is not set).",
    doneTitle:"Thank you!", doneText:"We received your request and will contact you by email soon."
  },
  ko:{
    title:"IEG 시뮬레이터 체험 신청",
    lead:"체험해 보고 싶은 시뮬레이터를 선택하고 간단한 정보를 남겨 주세요. 담당자가 체험 계정과 함께 연락드리겠습니다.",
    simLegend:"어떤 시뮬레이터에 관심 있으신가요?", simHint:"하나 이상 선택해 주세요.",
    aboutLegend:"신청자 정보", name:"이름", email:"이메일", phone:"연락처 (전화 / WhatsApp)",
    country:"국가 / 지역", city:"도시", org:"소속", ctype:"소속 유형", job:"직업 / 직책",
    select:"선택…",
    ct1:"TVET / 직업훈련기관", ct2:"대학 / 폴리텍", ct3:"기업 / 산업체",
    ct4:"정부 / 공공기관 / ODA", ct5:"유통사 / 파트너", ct6:"개인 강사 / 트레이너",
    ct7:"학생 / 학습자", ct8:"기타",
    motLegend:"체험 목적", purpose:"시뮬레이터를 체험하려는 주된 이유",
    p1:"개인 학습", p2:"학생 / 훈련생 교육", p3:"교육과정에 도입",
    p4:"구매 / 입찰 준비", p5:"파트너십 / 유통", p6:"연구 / 평가", p7:"기타",
    message:"추가로 전달하실 내용", messagePh:"훈련생 규모, 일정, 문의사항 등",
    consent:"체험 안내 및 관련 서비스 연락을 위해 IEG가 제 정보를 사용하는 데 동의합니다.",
    submit:"체험 신청하기", sending:"전송 중…",
    weeks:"주", wk:"주", selected:n=>`${n}개 선택됨`,
    eReq:"필수 입력 항목입니다.", eEmail:"올바른 이메일 주소를 입력해 주세요.", eSim:"시뮬레이터를 하나 이상 선택해 주세요.",
    eConsent:"동의 후 진행할 수 있습니다.", eNet:"전송에 실패했습니다. 연결을 확인하고 다시 시도해 주세요.",
    eCfg:"설문이 아직 구글시트와 연결되지 않았습니다 (APPS_SCRIPT_URL 미설정).",
    doneTitle:"감사합니다!", doneText:"신청이 접수되었습니다. 곧 이메일로 연락드리겠습니다."
  }
};

let lang = (navigator.language || "en").toLowerCase().startsWith("ko") ? "ko" : "en";
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];

function buildSims(){
  const box = $("#sims");
  box.innerHTML = "";
  SIMULATORS.forEach((s,i)=>{
    const l = document.createElement("label");
    l.className = "sim";
    const nameMain = lang==="ko" ? s.ko : s.value;
    const nameSub  = lang==="ko" ? s.value : "";
    l.innerHTML = `<input type="checkbox" name="sim" value="${s.value.replace(/"/g,"&quot;")}">
      <span class="wk"><b>${s.weeks}</b><small>${I18N[lang].wk}</small></span>
      <span class="nm">${nameMain}${nameSub?`<small>${nameSub}</small>`:""}</span>
      <span class="tick" aria-hidden="true">✓</span>`;
    box.appendChild(l);
  });
  $$("#sims input").forEach(cb=>cb.addEventListener("change",updateCount));
}
function checkedSims(){ return $$("#sims input:checked").map(c=>c.value); }
function updateCount(){
  const n = checkedSims().length;
  $("#simCount").textContent = n ? I18N[lang].selected(n) : "";
  if(n) $("#err-sims").textContent = "";
}

function applyLang(){
  const t = I18N[lang];
  document.documentElement.lang = lang;
  $$("[data-i18n]").forEach(el=>{ const k=el.dataset.i18n; if(t[k]!==undefined) el.textContent = t[k]; });
  $$("[data-i18n-ph]").forEach(el=>{ el.placeholder = t[el.dataset.i18nPh]; });
  $$(".lang button").forEach(b=>b.setAttribute("aria-pressed", b.dataset.lang===lang));
  const keep = checkedSims();
  buildSims();
  $$("#sims input").forEach(cb=>{ cb.checked = keep.includes(cb.value); });
  updateCount();
}

$$(".lang button").forEach(b=>b.addEventListener("click",()=>{ lang=b.dataset.lang; applyLang(); }));
$("#countryList").innerHTML = COUNTRIES.map(c=>`<option value="${c}">`).join("");

function setErr(id, msg, inputEl){
  $("#err-"+id).textContent = msg || "";
  if(inputEl) inputEl.classList.toggle("invalid", !!msg);
}

function validate(){
  const t = I18N[lang]; let first = null, ok = true;
  const req = [["name","#name"],["country","#country"],["org","#org"],["ctype","#ctype"],["purpose","#purpose"]];
  req.forEach(([id,sel])=>{
    const el = $(sel); const bad = !el.value.trim();
    setErr(id, bad ? t.eReq : "", el);
    if(bad){ ok=false; first = first || el; }
  });
  const em = $("#email"); const emBad = !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em.value.trim());
  setErr("email", emBad ? t.eEmail : "", em);
  if(emBad){ ok=false; first = first || em; }
  if(!checkedSims().length){ setErr("sims", t.eSim); ok=false; first = first || $("#simFieldset"); }
  if(!$("#consent").checked){ setErr("consent", t.eConsent); ok=false; first = first || $("#consent"); }
  else setErr("consent","");
  if(first) first.scrollIntoView({behavior:"smooth",block:"center"});
  return ok;
}

$("#survey").addEventListener("submit", async e=>{
  e.preventDefault();
  const t = I18N[lang]; $("#status").textContent = "";
  if(!validate()) return;
  if($("[name=website]").value) return; // bot

  if(!APPS_SCRIPT_URL || APPS_SCRIPT_URL.startsWith("PASTE_")){ $("#status").textContent = t.eCfg; return; }

  const sims = checkedSims();
  const payload = {
    name: $("#name").value.trim(), email: $("#email").value.trim(), phone: $("#phone").value.trim(),
    country: $("#country").value.trim(), city: $("#city").value.trim(),
    organization: $("#org").value.trim(), customerType: $("#ctype").value,
    jobTitle: $("#job").value.trim(), purpose: $("#purpose").value,
    message: $("#message").value.trim(), simulators: sims,
    language: lang, source: document.referrer || location.href, consent: true,
    website: $("[name=website]").value
  };

  const btn = $("#submitBtn"); btn.disabled = true; btn.textContent = t.sending;
  try{
    // text/plain 으로 보내면 CORS preflight 없이 Apps Script가 받을 수 있습니다.
    await fetch(APPS_SCRIPT_URL, { method:"POST", mode:"no-cors",
      headers:{"Content-Type":"text/plain;charset=utf-8"}, body: JSON.stringify(payload) });
    $("#formArea").style.display = "none";
    $("#done").style.display = "block";
    window.scrollTo({top:0,behavior:"smooth"});
  }catch(err){
    $("#status").textContent = t.eNet;
    btn.disabled = false; btn.textContent = t.submit;
  }
});

applyLang();
</script>
</body>
</html>
